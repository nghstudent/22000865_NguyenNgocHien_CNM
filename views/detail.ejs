<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Chi tiết sản phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container mt-5" style="max-width: 800px;">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Chi tiết sản phẩm</h4>
                <a href="/" class="btn btn-light btn-sm text-primary fw-bold">Quay lại</a>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-5 text-center mb-3 mb-md-0">
                        <% if(product.url_image) { %>
                            <img src="<%= product.url_image %>" class="img-fluid rounded shadow-sm" alt="Product Image">
                            <% } else { %>
                                <div class="p-5 bg-secondary text-white rounded">Không có hình ảnh</div>
                                <% } %>
                    </div>
                    <div class="col-md-7">
                        <h2 class="text-primary mb-3">
                            <%= product.name %>
                        </h2>
                        <ul class="list-group list-group-flush mb-4">
                            <!-- <li class="list-group-item"><strong>Mã sản phẩm (ID):</strong> <span class="text-muted"><%= product.id %></span></li> -->
                            <li class="list-group-item"><strong>Giá bán:</strong> <span class="text-danger fw-bold fs-5"><%= product.price.toLocaleString('vi-VN') %> VNĐ</span></li>
                            <li class="list-group-item"><strong>Tồn kho:</strong> <span class="badge bg-success fs-6"><%= product.unit_in_stock %></span> cái</li>
                        </ul>
                        <div class="d-flex gap-2">
                            <a href="/edit/<%= product.id %>" class="btn btn-warning px-4">Sửa thông tin</a>
                            <a href="/delete/<%= product.id %>" class="btn btn-danger px-4" onclick="return confirm('Xác nhận xóa?')">Xóa sản phẩm</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>