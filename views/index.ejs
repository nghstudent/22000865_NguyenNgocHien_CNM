<!DOCTYPE html>
<html>

<head>
    <title>Quản lý sản phẩm</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header>
        <h1>Quản lý sản phẩm</h1>
    </header>

    <div class="container">
        <a href="/add" class="button">+ Thêm sản phẩm</a>

        <table>
            <tr>
                <th>Ảnh</th>
                <th>Tên</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Hành động</th>
            </tr>

            <% products.forEach(p => { %>
                <tr>
                    <td><img src="<%= p.url_image.S %>" width="80"></td>
                    <td>
                        <%= p.name.S %>
                    </td>
                    <td>
                        <%= p.price.N %>
                    </td>
                    <td>
                        <%= p.quantity.N %>
                    </td>
                    <td>
                        <a href="/edit/<%= p.id.S %>">Sửa</a> |
                        <a href="/delete/<%= p.id.S %>" onclick="return confirm('Xoá sản phẩm này?')">
             Xoá
          </a>
                    </td>
                </tr>
                <% }) %>
        </table>
    </div>

    <footer>
        Nguyễn Ngọc Hiền – 22000865
    </footer>

</body>

</html>