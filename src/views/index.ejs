<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Quản lý sản phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        img {
            max-width: 80px;
            height: auto;
            border-radius: 5px;
        }
        
        .container {
            margin-top: 30px;
        }
        
        .search-box {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid #dee2e6;
        }
    </style>
</head>

<body class="container">
    <h2 class="text-center mb-4">Danh sách sản phẩm (AWS S3 & DynamoDB)</h2>

    <div class="card card-body mb-4">
        <h5 class="card-title">Thêm sản phẩm mới</h5>
        <form action="/add" method="POST" enctype="multipart/form-data" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="name" class="form-control" placeholder="Tên sản phẩm" required>
            </div>
            <div class="col-md-2">
                <input type="number" name="price" class="form-control" placeholder="Giá" required>
            </div>
            <div class="col-md-2">
                <input type="number" name="quantity" class="form-control" placeholder="Số lượng" required>
            </div>
            <div class="col-md-3">
                <input type="file" name="image" class="form-control" accept="image/*" required>
            </div>
            <div class="col-md-1">
                <button class="btn btn-success w-100">Thêm</button>
            </div>
        </form>
    </div>

    <div class="search-box">
        <form action="/" method="GET" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="fw-bold">Tìm kiếm:</label>
            </div>
            <div class="col-md-5">
                <input type="text" name="search" class="form-control" placeholder="Nhập tên sản phẩm..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                <% if (typeof keyword !== 'undefined' && keyword) { %>
                    <a href="/" class="btn btn-outline-secondary">Xóa lọc</a>
                    <% } %>
            </div>
        </form>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            <% if (products.length > 0) { %>
                <% products.forEach(p => { %>
                    <tr>
                        <td class="text-center text-muted" style="font-size: 0.8rem;">
                            <%= p.id.substring(0, 8) %>...
                        </td>
                        <td class="text-center"><img src="<%= p.image %>" alt="product"></td>
                        <td class="fw-bold text-primary">
                            <%= p.name %>
                        </td>
                        <td class="text-center">$
                            <%= p.price %>
                        </td>
                        <td class="text-center">
                            <%= p.quantity %>
                        </td>
                        <td class="text-center">
                            <a href="/edit/<%= p.id %>" class="btn btn-sm btn-warning">Sửa</a>
                            <a href="/delete/<%= p.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Bạn chắc chắn muốn xóa sản phẩm này?')">Xóa</a>
                        </td>
                    </tr>
                    <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy sản phẩm nào.</td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</body>

</html>