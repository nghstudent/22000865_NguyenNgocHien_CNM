<h3 class="mb-3">Product List</h3>

<a href="/products/create" class="btn btn-primary mb-3">
  + Add Product
</a>

<table class="table table-bordered table-hover bg-white">
  <thead class="table-dark">
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Price</th>
      <th width="180">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><%= p.id %></td>
        <td><%= p.name %></td>
        <td><%= p.price %></td>
        <td>
          <a href="/products/edit/<%= p.id %>" class="btn btn-sm btn-warning">Edit</a>
          <a href="/products/delete/<%= p.id %>" 
             onclick="return confirm('Delete this product?')" 
             class="btn btn-sm btn-danger">
             Delete
          </a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
